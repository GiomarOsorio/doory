# Doory reference AI server for background removal (uvicorn, FastAPI, rembg) on 127.0.0.1:7000, without Docker.
# Optional: install it next to deploy/doory-api.service and configure AI_PROVIDER_1_URL=http://127.0.0.1:7000 in .env.
# Open-source models only (Apache-2.0 / MIT). CPU-friendly (~1.4 GB RAM, ~1.4s per image).
[Unit]
Description=Doory reference AI server (background removal)
After=network.target doory-api.service

[Service]
User=doory
Group=doory
WorkingDirectory=/opt/doory/deploy/ai-server
Environment=U2NET_HOME=/var/lib/doory/models
Environment=OMP_NUM_THREADS=4
Environment=DEFAULT_MODEL=isnet-general-use
ExecStart=/opt/doory/deploy/ai-server/.venv/bin/uvicorn app:app \
    --host 127.0.0.1 --port 7000 --workers 1 \
    --no-server-header --timeout-graceful-shutdown 20
Restart=always
RestartSec=5
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
